prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: alwan
Description: Alwan colour science library (C11)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lalwan
Libs.private: @_ALWAN_PKGCONFIG_LIBS_PRIVATE@
Cflags: -I${includedir} -DALWAN_EMBED_DATA=@_ALWAN_EMBED_DATA_VALUE@

